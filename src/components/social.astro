---
const { hover, icon, link } = Astro.props;
import { Icon } from "astro-icon/components";
---

<a
  href=`${link}`
  target="_blank"
  rel="me"
  data-hover-name=`${hover}`
  class="icons hover:text-ctp-lavender"
>
  <Icon name=`${icon}` />
</a>

<script>
  const nameText = document.getElementById("username");
  const defaultName = nameText?.textContent;
  const icons = document.querySelectorAll(".icons");
  icons.forEach((element) => {
    const newName = element.dataset.hoverName;
    if (!newName) {
      return;
    }
    element.addEventListener("mouseover", () => {
      nameText.textContent = newName;
    });
    element.addEventListener("focus", () => {
      nameText.textContent = newName;
    });
    element.addEventListener("mouseout", () => {
      nameText.textContent = defaultName;
    });
    element.addEventListener("blur", () => {
      nameText.textContent = defaultName;
    });
  });
</script>
